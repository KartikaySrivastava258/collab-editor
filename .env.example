# Copy to .env (never commit real keys). Every variable is optional.

# HTTP port for the Go server.
PORT=8080

# Browser origins allowed to open WebSockets / call /api (comma-separated).
# Same-origin requests are always allowed; non-browser clients send no Origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory with the built frontend (frontend/dist). Empty = API only.
STATIC_DIR=

# Limits (memory is bounded by roughly MAX_ROOMS x MAX_DOC_ATOMS atoms).
MAX_DOC_ATOMS=200000
MAX_ROOMS=100
MAX_CLIENTS_PER_ROOM=50
MAX_MESSAGE_BYTES=262144

# Optional AI suggestions via an OpenAI-compatible API. Leave LLM_API_KEY
# empty to disable AI (editing is unaffected). LLM_MODEL is required with a key.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=
AI_TIMEOUT_MS=20000

SHUTDOWN_TIMEOUT_MS=10000
LOG_FORMAT=json

# Frontend dev server only (npm run dev): WebSocket URL to connect to.
COLLAB_WS_URL=ws://localhost:8080/ws
